{
  "name": "@lanonasis/memory-service-maas",
  "version": "1.2.0-dev",
  "description": "[DEVELOPMENT] Enterprise Memory as a Service (MaaS) with API Key Management and MCP Integration",
  "main": "dist/server.js",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/ide-extension-core",
    "packages/memory-client",
    "IDE-EXTENSIONS/*"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:cli": "cd cli && bun run test",
    "test:mcp-core": "jest --config apps/mcp-core/jest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage && jest --config apps/mcp-core/jest.config.ts --coverage",
    "test:conformance": "vitest run --config vitest.config.ts tests/conformance",
    "test:conformance:discovery": "vitest run --config vitest.config.ts tests/conformance/discovery.test.ts",
    "test:conformance:auth": "vitest run --config vitest.config.ts tests/conformance/auth-headers.test.ts",
    "test:all": "bun run test && bun run test:conformance && bun run test:cli",
    "lint": "bun x eslint src/**/*.ts",
    "lint:fix": "bun x eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "validate:env": "tsx scripts/validate-env.ts",
    "docker:build": "docker build -t lanonasis-maas .",
    "docker:run": "docker run -p 3000:3000 lanonasis-maas",
    "docker:push": "docker push lanonasis-maas",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "deploy": "./scripts/deploy.sh deploy",
    "deploy:staging": "./scripts/deploy.sh deploy --env staging",
    "deploy:production": "./scripts/deploy.sh deploy --env production",
    "publish:all": "./scripts/deploy.sh publish-sdk && ./scripts/deploy.sh publish-cli",
    "publish:sdk": "./scripts/deploy.sh publish-sdk",
    "publish:cli": "./scripts/deploy.sh publish-cli",
    "build:all": "./scripts/deploy.sh build",
    "clean": "./scripts/deploy.sh clean",
    "workspace:install": "npm ci && npm ci --prefix cli && npm ci --prefix packages/lanonasis-sdk",
    "workspace:build": "npm run build && npm run build --prefix cli && npm run build --prefix packages/lanonasis-sdk",
    "workspace:test": "bun run test && bun run test:cli && (cd packages/lanonasis-sdk && bun run test)",
    "workspace:lint": "npm run lint && npm run lint --prefix cli && npm run lint --prefix packages/lanonasis-sdk",
    "build:cli": "cd cli && bun install --frozen-lockfile && bun run build",
    "test:cli:integration": "cd cli && bun install --frozen-lockfile && bun run build && bun run test -- test/integration.test.ts --testPathIgnorePatterns 'test/load\\.' --testTimeout 60000",
    "test:cli:integration:live": "cd cli && bun install --frozen-lockfile && bun run build && RUN_CLI_HTTP_INTEGRATION=true bun run test -- test/integration.test.ts --testPathIgnorePatterns 'test/load\\.' --testTimeout 60000",
    "test:cli:integration:mcp": "cd cli && bun install --frozen-lockfile && bun run build && RUN_CLI_MCP_INTEGRATION=true bun run test -- test/integration.test.ts --testPathIgnorePatterns 'test/load\\.' --testTimeout 60000",
    "package:claude-memory:install": "npm install --prefix packages/claude-memory",
    "package:claude-memory:build": "npm run build --prefix packages/claude-memory",
    "package:claude-memory:test": "npm run test --prefix packages/claude-memory",
    "package:claude-memory:typecheck": "npm run typecheck --prefix packages/claude-memory"
  },
  "keywords": [
    "memory",
    "ai",
    "microservice",
    "vector-search",
    "enterprise",
    "api-keys",
    "secrets",
    "mcp",
    "security",
    "maas"
  ],
  "author": "Seye Derick",
  "license": "MIT",
  "dependencies": {
    "@genkit-ai/mcp": "^1.42.0",
    "@lanonasis/oauth-client": "npm:@lanonasis/oauth-client@2.0.4",
    "@lanonasis/security-sdk": "^1.0.5",
    "@netlify/functions": "^2.8.2",
    "@supabase/supabase-js": "^2.116.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^2.7.0",
    "openai": "^4.104.0",
    "react": "19.2.1",
    "react-dom": "19.2.0",
    "redis": "^4.7.1",
    "serverless-http": "^3.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.1",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "axios": "^1.20.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "jwt-decode": "^4.0.0",
    "patch-package": "^8.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "vitest": "^4.1.9",
    "path-to-regexp": "^8.4.0",
    "handlebars": "^4.7.9",
    "form-data": "^4.0.4",
    "fast-uri": "^3.1.6",
    "ws": "^8.20.1",
    "validator": "^13.15.20",
    "qs": "^6.15.4",
    "picomatch": "^2.3.2",
    "minimatch": "^3.1.4",
    "brace-expansion": "^2.0.2",
    "glob": "^10.5.0",
    "js-yaml": "^4.1.1",
    "protobufjs": "^8.8.0",
    "@grpc/grpc-js": "^1.12.6",
    "node-forge": "^1.3.2",
    "xml2js": "^0.5.0",
    "semver": "^7.6.3",
    "cross-spawn": "^7.0.6",
    "ip-address": "^10.0.1",
    "cookie": "^0.7.2",
    "tmp": "^0.2.4",
    "yaml": "^2.8.0",
    "websocket-driver": "^0.7.5",
    "fast-xml-parser": "^5.7.0",
    "jws": "^3.2.3",
    "@tootallnate/once": "^2.0.0",
    "body-parser": "^1.20.4",
    "update-browserslist-db": "^1.1.4",
    "ajv": "^8.17.1",
    "lodash": "^4.17.22",
    "@babel/helper-module-transforms": "^7.26.0"
  }
}

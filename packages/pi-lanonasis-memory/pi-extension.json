{
  "name": "@lanonasis/pi-lanonasis-memory",
  "version": "0.2.0",
  "description": "LanOnasis MaaS Memory — Pi extension that auto-captures assistant responses and corrected facts into a local SQLite FTS5 store, with optional MaaS federation for cross-device sync.",
  "entry": "./dist/index.js",
  "source": "./src/index.ts",
  "extensions": ["./src/index.ts", "./dist/index.js"],
  "commands": [
    {
      "name": "echo",
      "description": "Smoke test — reverses its argument.",
      "handler": "src/commands/echo.ts"
    }
  ],
  "storage_roots": {
    "global": "~/.pi/agent/lanonasis-pi-memory",
    "project": "~/.pi/agent/projects-memory/<project>",
    "sessions_db": "~/.pi/agent/lanonasis-pi-memory/sessions.db"
  },
  "memory_client": {
    "package": "@lanonasis/memory-client",
    "subexport": "./node",
    "provider": "createNodeMemoryClient"
  },
  "min_pi_sdk": {
    "@earendil-works/pi-coding-agent": ">=0.80.1",
    "@earendil-works/pi-ai": ">=0.80.1"
  }
}
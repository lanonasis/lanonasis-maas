{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "rootDir": "..",
    "types": ["node"]
  },
  "include": [
    "src/local-memory/**/*.ts",
    "tests/local-memory/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
